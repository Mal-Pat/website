---
import { type CollectionEntry, getCollection, render } from 'astro:content'

import SlideLayout from '@/layouts/SlideLayout.astro'

export const prerender = true

// Rest param (like the blog route) so a deck can be either `my-deck.mdx` or a
// folder `my-deck/index.mdx` holding its own images, at any nesting depth — a
// plain `[id]` cannot represent the slashes in a nested collection id.
export async function getStaticPaths() {
  const decks = await getCollection('slides', ({ data }) => !data.draft)
  return decks.map((deck) => ({
    params: { id: deck.id },
    props: { deck }
  }))
}

type Props = {
  deck: CollectionEntry<'slides'>
}

const { deck } = Astro.props
const { Content } = await render(deck)
---

<SlideLayout meta={{ title: deck.data.title, description: deck.data.description }}>
  <Content />
</SlideLayout>

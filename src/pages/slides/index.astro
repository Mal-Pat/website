---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const decks = (await getCollection('slides', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0)
)

const meta = {
  description: 'Presentation slide decks',
  title: 'Slides'
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Slides</h1>
    </div>

    <section id='content' class='animate' aria-label='Slide deck list'>
      {decks.length === 0 && <p>No decks yet.</p>}
      <ul class='flex flex-col gap-y-4'>
        {
          decks.map((deck) => (
            <li>
              <a
                href={`/slides/${deck.id}`}
                class='flex flex-col gap-y-1 rounded-xl border px-5 py-4 transition-colors hover:bg-muted'
              >
                <span class='font-medium'>{deck.data.title}</span>
                <span class='text-sm text-muted-foreground'>{deck.data.description}</span>
                {deck.data.publishDate && (
                  <time class='text-sm text-muted-foreground' datetime={deck.data.publishDate.toISOString()}>
                    {deck.data.publishDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</PageLayout>

---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Standalone fullscreen shell for presentation decks: no site header/footer,
// no max-width container. Theme tokens, fonts and dark mode still apply.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import 'katex/dist/katex.min.css'

interface Props {
  meta: SiteMeta
}

const {
  meta: { description = config.description, ogImage, title }
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='bg-background text-foreground'>
    <main id='slides-viewport' aria-label={title}>
      <slot />
    </main>

    {/* Overlay controls */}
    <div id='slides-progress' aria-hidden='true'></div>
    <a id='slides-home' href='/' title={`Back to ${config.title}`}>✕</a>
    <div id='slides-controls'>
      <button id='slides-prev' type='button' aria-label='Previous slide'>←</button>
      <input
        id='slides-scrubber'
        type='range'
        min='1'
        step='1'
        value='1'
        aria-label='Go to slide'
      />
      <span id='slides-counter'>
        <input
          id='slides-number'
          type='number'
          min='1'
          step='1'
          value='1'
          inputmode='numeric'
          aria-label='Current slide'
        />
        <span id='slides-total' aria-hidden='true'></span>
      </span>
      <span id='slides-announcement' class='sr-only' aria-live='polite'></span>
      <button id='slides-next' type='button' aria-label='Next slide'>→</button>
    </div>

    <style is:global>
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
        overscroll-behavior: none;
      }

      #slides-viewport {
        position: fixed;
        inset: 0;
        background-color: hsl(var(--background) / 1);
      }

      .slide {
        /* Column width shared by the slide body and its references footer. */
        --slide-width: 68rem;
        position: absolute;
        inset: 0;
        /* Two rows: the body takes all free space and centres within it, the
           references footer sits in an auto row pinned to the bottom. Slides
           with no footer get a zero-height second row, so they look unchanged. */
        display: grid;
        grid-template-rows: 1fr auto;
        align-items: center;
        padding: clamp(1.5rem, 5vw, 4rem);
        padding-top: calc(clamp(1.5rem, 5vw, 4rem) + env(safe-area-inset-top));
        padding-bottom: calc(clamp(1.5rem, 5vw, 4rem) + env(safe-area-inset-bottom));
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.75rem);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease,
          visibility 0s linear 0.3s;
      }
      .slide.active {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }
      /* Before the nav script initializes, show the first slide so there is
         no blank flash; the script adds .js-nav and takes over from there. */
      #slides-viewport:not(.js-nav) .slide:first-of-type {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
      @media (prefers-reduced-motion) {
        .slide {
          transition: none;
        }
      }

      /* These are scoped under `.slide` on purpose. The body also carries the
         theme's `prose` class, whose `:is(.prose)` rule sets font-size and
         max-width at equal specificity — so a bare `.slide-body` selector only
         wins on source order. Dev injects UnoCSS twice (once after the layout's
         styles), so prose would win there and these would silently do nothing.
         The extra class keeps slides sized correctly in dev and build alike. */
      .slide .slide-body {
        width: 100%;
        max-width: var(--slide-width);
        margin-inline: auto;
        max-height: 100%;
        overflow-y: auto;
        font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
      }
      .slide .slide-body h1 {
        font-size: 2.4em;
        line-height: 1.15;
      }
      .slide .slide-body h2 {
        font-size: 1.7em;
        line-height: 1.2;
      }
      /* Hide heading anchor links inside slides: the theme keeps them in
         layout flow (opacity 0 + margin), which visually un-centers headings,
         and their heading-id hash would clash with the slide-position hash. */
      .slide .slide-body :is(h1, h2, h3, h4, h5, h6) > a.anchor {
        display: none;
      }
      .slide .slide-body > :first-child { 
        margin-top: 0; 
      }
      .slide .slide-body > :last-child { 
        margin-bottom: 0; 
      }
      /* Figures (SlideImage). Selectors are scoped tightly enough to beat the
         prose rules on `figure`/`img`, which otherwise impose their own
         margins and would fight the alignment below. */
      .slide .slide-body .slide-figure {
        margin-block: 1em;
        max-width: 100%;
      }
      .slide .slide-body .slide-figure :is(img) {
        display: block;
        width: 100%;
        height: auto;
        margin: 0;
        border-radius: 0.5rem;
      }
      .slide .slide-body .slide-figure figcaption {
        margin-top: 0.4em;
        font-size: 0.62em;
        line-height: 1.4;
        color: hsl(var(--muted-foreground) / 1);
        text-align: start;
      }

      /* Block placement: shrink to the image, then push with auto margins.
         An explicit `width` on the element overrides the fit-content below. */
      .slide .slide-body .slide-figure:not(.is-wrap) {
        width: fit-content;
      }
      .slide .slide-body .slide-figure:not(.is-wrap).align-left {
        margin-inline: 0 auto;
      }
      .slide .slide-body .slide-figure:not(.is-wrap).align-center {
        margin-inline: auto;
      }
      .slide .slide-body .slide-figure:not(.is-wrap).align-right {
        margin-inline: auto 0;
      }

      /* Wrapped placement: float so following text flows alongside. The float
         is contained by `.slide-body`, which is already a block formatting
         context via `overflow-y: auto`. */
      .slide .slide-body .slide-figure.is-wrap {
        margin-block: 0.2em 0.8em;
      }
      .slide .slide-body .slide-figure.is-wrap.align-right {
        float: right;
        margin-inline-start: 1.5em;
      }
      .slide .slide-body .slide-figure.is-wrap.align-left {
        float: left;
        margin-inline-end: 1.5em;
      }

      /* References footer. Kept outside `.slide-body` so it is not affected by
         the prose styles or the body's scrolling, and always left-aligned even
         on centred slides, where centred citations read poorly. */
      .slide .slide-refs {
        width: 100%;
        max-width: var(--slide-width);
        margin-inline: auto;
        padding-top: 0.6rem;
        border-top: 1px solid hsl(var(--border) / 1);
        color: hsl(var(--muted-foreground) / 1);
        font-size: clamp(0.75rem, 0.65rem + 0.35vw, 1.05rem);
        line-height: 1.45;
        text-align: start;
      }
      .slide .slide-refs :is(p, ul, ol) {
        margin: 0;
      }
      /* The theme's CSS reset strips list markers, and prose only restores them
         inside `.prose` — which the footer deliberately sits outside of. */
      .slide .slide-refs :is(ul, ol) {
        padding-inline-start: 1.4em;
        list-style-position: outside;
      }
      .slide .slide-refs ol {
        list-style-type: decimal;
      }
      .slide .slide-refs ul {
        list-style-type: disc;
      }
      .slide .slide-refs li + li {
        margin-top: 0.2em;
      }
      .slide .slide-refs a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .slide-center {
        text-align: center;
      }
      .slide-center .slide-body ul,
      .slide-center .slide-body ol {
        list-style-position: inside;
      }

      /* Overlay controls */
      #slides-progress {
        position: fixed;
        top: 0;
        inset-inline-start: 0;
        height: 3px;
        width: 0;
        background-color: hsl(var(--primary) / 1);
        transition: width 0.3s ease;
        z-index: 10;
      }
      #slides-home {
        position: fixed;
        top: calc(0.75rem + env(safe-area-inset-top));
        inset-inline-end: calc(1rem + env(safe-area-inset-right));
        z-index: 10;
        font-size: 1rem;
        line-height: 1;
        padding: 0.5rem;
        color: hsl(var(--muted-foreground) / 1);
        text-decoration: none;
      }
      #slides-home:hover {
        color: hsl(var(--foreground) / 1);
      }
      #slides-controls {
        position: fixed;
        bottom: calc(0.75rem + env(safe-area-inset-bottom));
        inset-inline-end: calc(1rem + env(safe-area-inset-right));
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: hsl(var(--muted-foreground) / 1);
        font-size: 0.9rem;
      }
      #slides-controls button {
        border: none;
        background: none;
        cursor: pointer;
        padding: 0.4rem 0.6rem;
        border-radius: 0.5rem;
        color: inherit;
        font-size: 1rem;
        line-height: 1;
      }
      #slides-controls button:hover:not(:disabled) {
        background-color: hsl(var(--muted) / 1);
        color: hsl(var(--foreground) / 1);
      }
      #slides-controls button:disabled {
        opacity: 0.35;
        cursor: default;
      }
      #slides-scrubber {
        width: clamp(6rem, 18vw, 14rem);
        margin-inline: 0.35rem;
        cursor: pointer;
        accent-color: hsl(var(--primary) / 1);
      }
      #slides-counter {
        display: flex;
        align-items: center;
        min-width: 5rem;
        font-variant-numeric: tabular-nums;
        user-select: none;
      }
      #slides-number {
        width: 3.25em;
        border: 1px solid transparent;
        border-radius: 0.35rem;
        outline: none;
        background: transparent;
        color: inherit;
        font: inherit;
        font-variant-numeric: tabular-nums;
        text-align: end;
        appearance: textfield;
      }
      #slides-number::-webkit-inner-spin-button,
      #slides-number::-webkit-outer-spin-button {
        margin: 0;
        appearance: none;
      }
      #slides-number:hover {
        border-color: hsl(var(--border) / 1);
      }
      #slides-number:focus-visible {
        border-color: hsl(var(--primary) / 1);
        outline: 2px solid hsl(var(--primary) / 0.3);
        outline-offset: 1px;
        color: hsl(var(--foreground) / 1);
      }
    </style>

    <script>
      const viewport = document.getElementById('slides-viewport')!
      const slides = Array.from(viewport.querySelectorAll<HTMLElement>('.slide'))
      const progress = document.getElementById('slides-progress')!
      const prevBtn = document.getElementById('slides-prev') as HTMLButtonElement
      const nextBtn = document.getElementById('slides-next') as HTMLButtonElement
      const scrubber = document.getElementById('slides-scrubber') as HTMLInputElement
      const slideNumber = document.getElementById('slides-number') as HTMLInputElement
      const slideTotal = document.getElementById('slides-total')!
      const slideAnnouncement = document.getElementById('slides-announcement')!

      let current = 0

      scrubber.max = String(slides.length)
      slideNumber.max = String(slides.length)
      slideTotal.textContent = ` / ${slides.length}`

      function setSlidePlayersActive(slide: HTMLElement, active: boolean) {
        const players = slide.querySelectorAll<HTMLIFrameElement>('iframe[data-slide-player-src]')
        for (const player of players) {
          const playerSrc = player.dataset.slidePlayerSrc
          if (!playerSrc) continue

          if (active) {
            if (player.getAttribute('src') !== playerSrc) player.src = playerSrc
          } else if (player.getAttribute('src') !== 'about:blank') {
            // Unloading is more reliable than trying to message a provider's
            // player API, and guarantees that hidden slides cannot keep
            // playing audio. Returning to the slide restarts at its start time.
            player.src = 'about:blank'
          }
        }
      }

      function goTo(index: number, updateHash = true) {
        if (slides.length === 0) return
        current = Math.max(0, Math.min(slides.length - 1, index))
        for (const [i, slide] of slides.entries()) {
          const active = i === current
          slide.classList.toggle('active', active)
          slide.setAttribute('aria-hidden', String(!active))
          setSlidePlayersActive(slide, active)
        }
        const displayNumber = String(current + 1)
        scrubber.value = displayNumber
        scrubber.setAttribute('aria-valuetext', `Slide ${displayNumber} of ${slides.length}`)
        slideNumber.value = displayNumber
        slideAnnouncement.textContent = `Slide ${displayNumber} of ${slides.length}`
        progress.style.width = `${((current + 1) / slides.length) * 100}%`
        prevBtn.disabled = current === 0
        nextBtn.disabled = current === slides.length - 1
        // replaceState instead of setting location.hash to avoid polluting
        // browser history with an entry per slide
        if (updateHash && (current > 0 || window.location.hash)) {
          history.replaceState(null, '', `#${current + 1}`)
        }
      }

      function slideFromHash(): number {
        const n = parseInt(window.location.hash.slice(1), 10)
        return Number.isFinite(n) ? n - 1 : 0
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return
        const target = e.target as HTMLElement | null
        if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return
        switch (e.key) {
          case 'ArrowRight':
          case 'PageDown':
            e.preventDefault()
            goTo(current + 1)
            break
          case 'ArrowLeft':
          case 'PageUp':
            e.preventDefault()
            goTo(current - 1)
            break
          case ' ':
            e.preventDefault()
            goTo(e.shiftKey ? current - 1 : current + 1)
            break
          case 'Home':
            e.preventDefault()
            goTo(0)
            break
          case 'End':
            e.preventDefault()
            goTo(slides.length - 1)
            break
          case 'f':
            if (document.fullscreenElement) document.exitFullscreen()
            else document.documentElement.requestFullscreen().catch(() => {})
            break
        }
      })

      prevBtn.addEventListener('click', () => goTo(current - 1))
      nextBtn.addEventListener('click', () => goTo(current + 1))
      scrubber.addEventListener('input', () => goTo(Number(scrubber.value) - 1))

      function commitSlideNumber() {
        const requested = Number(slideNumber.value)
        if (Number.isInteger(requested)) goTo(requested - 1)
        else slideNumber.value = String(current + 1)
      }

      slideNumber.addEventListener('change', commitSlideNumber)
      slideNumber.addEventListener('focus', () => slideNumber.select())
      slideNumber.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          commitSlideNumber()
          slideNumber.blur()
        } else if (e.key === 'Escape') {
          slideNumber.value = String(current + 1)
          slideNumber.blur()
        }
      })
      window.addEventListener('hashchange', () => goTo(slideFromHash(), false))

      // Horizontal swipe navigation for touch devices
      let touchX = 0
      let touchY = 0
      let trackingSwipe = false
      document.addEventListener(
        'touchstart',
        (e) => {
          const target = e.target as Element | null
          trackingSwipe = !target?.closest('#slides-controls')
          if (!trackingSwipe) return
          touchX = e.changedTouches[0].clientX
          touchY = e.changedTouches[0].clientY
        },
        { passive: true }
      )
      document.addEventListener(
        'touchend',
        (e) => {
          if (!trackingSwipe) return
          trackingSwipe = false
          const dx = e.changedTouches[0].clientX - touchX
          const dy = e.changedTouches[0].clientY - touchY
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            goTo(dx < 0 ? current + 1 : current - 1)
          }
        },
        { passive: true }
      )

      viewport.classList.add('js-nav')
      goTo(slideFromHash(), false)
    </script>
  </body>
</html>

---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Standalone fullscreen shell for presentation decks: no site header/footer,
// no max-width container. Theme tokens, fonts and dark mode still apply.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import 'katex/dist/katex.min.css'

interface Props {
  meta: SiteMeta
}

const {
  meta: { description = config.description, ogImage, title }
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='bg-background text-foreground'>
    <main id='slides-viewport' aria-label={title}>
      <slot />
    </main>

    {/* Overlay controls */}
    <div id='slides-progress' aria-hidden='true'></div>
    <a id='slides-home' href='/' title={`Back to ${config.title}`}>✕</a>
    <div id='slides-controls'>
      <button id='slides-prev' type='button' aria-label='Previous slide'>←</button>
      <span id='slides-counter' aria-live='polite'></span>
      <button id='slides-next' type='button' aria-label='Next slide'>→</button>
    </div>

    <style is:global>
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
        overscroll-behavior: none;
      }

      #slides-viewport {
        position: fixed;
        inset: 0;
        background-color: hsl(var(--background) / 1);
      }

      .slide {
        /* Column width shared by the slide body and its references footer. */
        --slide-width: 68rem;
        position: absolute;
        inset: 0;
        /* Two rows: the body takes all free space and centres within it, the
           references footer sits in an auto row pinned to the bottom. Slides
           with no footer get a zero-height second row, so they look unchanged. */
        display: grid;
        grid-template-rows: 1fr auto;
        align-items: center;
        padding: clamp(1.5rem, 5vw, 4rem);
        padding-top: calc(clamp(1.5rem, 5vw, 4rem) + env(safe-area-inset-top));
        padding-bottom: calc(clamp(1.5rem, 5vw, 4rem) + env(safe-area-inset-bottom));
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.75rem);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease,
          visibility 0s linear 0.3s;
      }
      .slide.active {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }
      /* Before the nav script initializes, show the first slide so there is
         no blank flash; the script adds .js-nav and takes over from there. */
      #slides-viewport:not(.js-nav) .slide:first-of-type {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
      @media (prefers-reduced-motion) {
        .slide {
          transition: none;
        }
      }

      /* These are scoped under `.slide` on purpose. The body also carries the
         theme's `prose` class, whose `:is(.prose)` rule sets font-size and
         max-width at equal specificity — so a bare `.slide-body` selector only
         wins on source order. Dev injects UnoCSS twice (once after the layout's
         styles), so prose would win there and these would silently do nothing.
         The extra class keeps slides sized correctly in dev and build alike. */
      .slide .slide-body {
        width: 100%;
        max-width: var(--slide-width);
        margin-inline: auto;
        max-height: 100%;
        overflow-y: auto;
        font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
      }
      .slide .slide-body h1 {
        font-size: 2.4em;
        line-height: 1.15;
      }
      .slide .slide-body h2 {
        font-size: 1.7em;
        line-height: 1.2;
      }
      /* Hide heading anchor links inside slides: the theme keeps them in
         layout flow (opacity 0 + margin), which visually un-centers headings,
         and their heading-id hash would clash with the slide-position hash. */
      .slide .slide-body :is(h1, h2, h3, h4, h5, h6) > a.anchor {
        display: none;
      }
      .slide .slide-body > :first-child { 
        margin-top: 0; 
      }
      .slide .slide-body > :last-child { 
        margin-bottom: 0; 
      }
      /* References footer. Kept outside `.slide-body` so it is not affected by
         the prose styles or the body's scrolling, and always left-aligned even
         on centred slides, where centred citations read poorly. */
      .slide .slide-refs {
        width: 100%;
        max-width: var(--slide-width);
        margin-inline: auto;
        padding-top: 0.6rem;
        border-top: 1px solid hsl(var(--border) / 1);
        color: hsl(var(--muted-foreground) / 1);
        font-size: clamp(0.75rem, 0.65rem + 0.35vw, 1.05rem);
        line-height: 1.45;
        text-align: start;
      }
      .slide .slide-refs :is(p, ul, ol) {
        margin: 0;
      }
      /* The theme's CSS reset strips list markers, and prose only restores them
         inside `.prose` — which the footer deliberately sits outside of. */
      .slide .slide-refs :is(ul, ol) {
        padding-inline-start: 1.4em;
        list-style-position: outside;
      }
      .slide .slide-refs ol {
        list-style-type: decimal;
      }
      .slide .slide-refs ul {
        list-style-type: disc;
      }
      .slide .slide-refs li + li {
        margin-top: 0.2em;
      }
      .slide .slide-refs a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .slide-center {
        text-align: center;
      }
      .slide-center .slide-body ul,
      .slide-center .slide-body ol {
        list-style-position: inside;
      }

      /* Overlay controls */
      #slides-progress {
        position: fixed;
        top: 0;
        inset-inline-start: 0;
        height: 3px;
        width: 0;
        background-color: hsl(var(--primary) / 1);
        transition: width 0.3s ease;
        z-index: 10;
      }
      #slides-home {
        position: fixed;
        top: calc(0.75rem + env(safe-area-inset-top));
        inset-inline-end: calc(1rem + env(safe-area-inset-right));
        z-index: 10;
        font-size: 1rem;
        line-height: 1;
        padding: 0.5rem;
        color: hsl(var(--muted-foreground) / 1);
        text-decoration: none;
      }
      #slides-home:hover {
        color: hsl(var(--foreground) / 1);
      }
      #slides-controls {
        position: fixed;
        bottom: calc(0.75rem + env(safe-area-inset-bottom));
        inset-inline-end: calc(1rem + env(safe-area-inset-right));
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: hsl(var(--muted-foreground) / 1);
        font-size: 0.9rem;
      }
      #slides-controls button {
        border: none;
        background: none;
        cursor: pointer;
        padding: 0.4rem 0.6rem;
        border-radius: 0.5rem;
        color: inherit;
        font-size: 1rem;
        line-height: 1;
      }
      #slides-controls button:hover:not(:disabled) {
        background-color: hsl(var(--muted) / 1);
        color: hsl(var(--foreground) / 1);
      }
      #slides-controls button:disabled {
        opacity: 0.35;
        cursor: default;
      }
      #slides-counter {
        min-width: 3.5rem;
        text-align: center;
        font-variant-numeric: tabular-nums;
        user-select: none;
      }
    </style>

    <script>
      const viewport = document.getElementById('slides-viewport')!
      const slides = Array.from(viewport.querySelectorAll<HTMLElement>('.slide'))
      const counter = document.getElementById('slides-counter')!
      const progress = document.getElementById('slides-progress')!
      const prevBtn = document.getElementById('slides-prev') as HTMLButtonElement
      const nextBtn = document.getElementById('slides-next') as HTMLButtonElement

      let current = 0

      function goTo(index: number, updateHash = true) {
        if (slides.length === 0) return
        current = Math.max(0, Math.min(slides.length - 1, index))
        for (const [i, slide] of slides.entries()) {
          slide.classList.toggle('active', i === current)
          slide.setAttribute('aria-hidden', String(i !== current))
        }
        counter.textContent = `${current + 1} / ${slides.length}`
        progress.style.width = `${((current + 1) / slides.length) * 100}%`
        prevBtn.disabled = current === 0
        nextBtn.disabled = current === slides.length - 1
        // replaceState instead of setting location.hash to avoid polluting
        // browser history with an entry per slide
        if (updateHash && (current > 0 || window.location.hash)) {
          history.replaceState(null, '', `#${current + 1}`)
        }
      }

      function slideFromHash(): number {
        const n = parseInt(window.location.hash.slice(1), 10)
        return Number.isFinite(n) ? n - 1 : 0
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return
        const target = e.target as HTMLElement | null
        if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return
        switch (e.key) {
          case 'ArrowRight':
          case 'PageDown':
            e.preventDefault()
            goTo(current + 1)
            break
          case 'ArrowLeft':
          case 'PageUp':
            e.preventDefault()
            goTo(current - 1)
            break
          case ' ':
            e.preventDefault()
            goTo(e.shiftKey ? current - 1 : current + 1)
            break
          case 'Home':
            e.preventDefault()
            goTo(0)
            break
          case 'End':
            e.preventDefault()
            goTo(slides.length - 1)
            break
          case 'f':
            if (document.fullscreenElement) document.exitFullscreen()
            else document.documentElement.requestFullscreen().catch(() => {})
            break
        }
      })

      prevBtn.addEventListener('click', () => goTo(current - 1))
      nextBtn.addEventListener('click', () => goTo(current + 1))
      window.addEventListener('hashchange', () => goTo(slideFromHash(), false))

      // Horizontal swipe navigation for touch devices
      let touchX = 0
      let touchY = 0
      document.addEventListener(
        'touchstart',
        (e) => {
          touchX = e.changedTouches[0].clientX
          touchY = e.changedTouches[0].clientY
        },
        { passive: true }
      )
      document.addEventListener(
        'touchend',
        (e) => {
          const dx = e.changedTouches[0].clientX - touchX
          const dy = e.changedTouches[0].clientY - touchY
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            goTo(dx < 0 ? current + 1 : current - 1)
          }
        },
        { passive: true }
      )

      viewport.classList.add('js-nav')
      goTo(slideFromHash(), false)
    </script>
  </body>
</html>
